{
  "name": "gulp-boilerplate",
  "version": "1.0.0",
  "description": "Frontend boilerplate based on gulp",
  "scripts": {
    "init": "mate-scripts init",
    "start": "mate-scripts start",
    "lint": "mate-scripts lint",
    "test:only": "mate-scripts test",
    "test:allure": "rm -rf allure-results && npx playwright test",
    "build": "mate-scripts build",
    "report:open": "allure serve allure-results",
    "report:generate": "mkdir -p allure-results && allure generate allure-results --clean -o allure-report",
    "report:publish": "gh-pages -d allure-report",
    "deploy": "npm run report:generate && npm run report:publish",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only"
  },
  "keywords": [],
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@linthtml/linthtml": "^0.9.6",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.12.0",
    "@playwright/test": "^1.61.1",
    "@types/fs-extra": "^11.0.4",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "fs-extra": "^11.3.6",
    "gh-pages": "^6.3.0",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "stylelint": "^16.7.0",
    "stylelint-scss": "^6.4.1"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "mateAcademy": {
    "projectType": "layout",
    "linters": {
      "bem": false
    }
  }
}
